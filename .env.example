# WebCMD Environment Configuration Example

# Data Directory & Database (defaults to ./data and ./data/webcmd.db)
WEBCMD_DATA_DIR=./data
WEBCMD_HOME=~/.webcmd

# Browser Mode: Set to "false" to open a visible, real Chromium browser window (Default: false)
# Set to "true" for headless background execution
WEBCMD_HEADLESS=false

# Port Configurations
WEBCMD_PORT=8000
TEST_LAB_PORT=9888

# AI / LLM Provider (Optional - fallback to deterministic planning if unconfigured)
# Supported providers: openai, anthropic, ollama
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=your_openai_api_key_here

# For local models via Ollama:
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.2
